---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>
<body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <!-- Header / Navigation -->
    <header class="navbar bg-base-100 shadow-md px-4 md:px-12 sticky top-0 z-50">
        <div class="flex-1">
            <a href="/" class="btn btn-ghost text-2xl font-bold text-sylvan-blue tracking-tighter">
                Sylvan Travel
            </a>
        </div>
        <div class="flex-none gap-4">
            <!-- Language Switcher -->
            <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2">
                    <span>🌐</span>
                    <span>中文/English</span>
                </div>
                <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-52">
                    <li><a>中文</a></li>
                    <li><a>English</a></li>
                </ul>
            </div>
            <!-- Quote Link -->
            <a href="/quote" class="btn btn-primary btn-sm bg-sylvan-gold hover:bg-yellow-600 text-white border-none">
                获取报价
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="footer p-10 bg-neutral text-neutral-content border-t border-base-300">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 w-full max-w-6xl mx-auto">
            <nav>
                <h6 class="footer-title opacity-100 font-bold mb-4">公司信息</h6> 
                <a class="link link-hover">关于我们</a>
                <a class="link link-hover">加入我们</a>
            </nav> 
            <nav>
                <h6 class="footer-title opacity-100 font-bold mb-4">支持中心</h6> 
                <a class="link link-hover">联系我们</a>
                <a class="link link-hover">隐私条款</a>
            </nav> 
            <nav>
                <h6 class="footer-title opacity-100 font-bold mb-4">法律声明</h6> 
                <p class="text-sm opacity-70">© 2026 Sylvan Travel. All rights reserved.</p>
            </nav>
        </div>
    </footer>
</body>
</html>
