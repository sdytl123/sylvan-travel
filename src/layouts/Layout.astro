---
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="alternate" hreflang="zh-CN" href={new URL(currentPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${currentPath}`, Astro.site)} />
</head>
<body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <!-- Header / Navigation -->
    <header class="navbar bg-base-100 shadow-md px-4 md:px-12 sticky top-0 z-50">
        <div class="flex-1">
            <a href="/" class="btn btn-ghost text-2xl font-bold text-sylvan-blue tracking-tighter">
                Sylvan Travel
            </a>
        </div>
        <div class="flex-none gap-4">
            <!-- Language Switcher -->
            <details class="dropdown dropdown-end">
                <summary class="btn btn-ghost btn-sm gap-2" aria-label="选择语言">
                    <span aria-hidden="true">🌐</span>
                    <span data-language-label>中文</span>
                </summary>
                <ul class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-52">
                    <li><a href={currentPath} data-language="zh" lang="zh-CN" aria-current="page">中文</a></li>
                    <li><a href={`/en${currentPath}`} data-language="en" lang="en">English</a></li>
                </ul>
            </details>
            <!-- Quote Link -->
            <a href="/quote" class="btn btn-primary btn-sm bg-sylvan-gold hover:bg-yellow-600 text-white border-none">
                获取报价
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="px-4 py-10 md:px-10 bg-neutral text-neutral-content border-t border-base-300">
        <div class="grid grid-cols-3 gap-4 md:gap-10 w-full max-w-6xl mx-auto">
            <nav class="flex min-w-0 flex-col items-start gap-2">
                <h6 class="footer-title opacity-100 font-bold mb-4">公司信息</h6> 
                <a class="link link-hover">关于我们</a>
                <a class="link link-hover">加入我们</a>
            </nav> 
            <nav class="flex min-w-0 flex-col items-start gap-2">
                <h6 class="footer-title opacity-100 font-bold mb-4">支持中心</h6> 
                <a class="link link-hover">联系我们</a>
                <a class="link link-hover">隐私条款</a>
            </nav> 
            <nav class="flex min-w-0 flex-col items-start gap-2">
                <h6 class="footer-title opacity-100 font-bold mb-4">法律声明</h6> 
                <p class="text-sm opacity-70 break-words">© 2026 Sylvan Travel. All rights reserved.</p>
            </nav>
        </div>
    </footer>
</body>
</html>
