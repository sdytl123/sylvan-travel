---
import Layout from '../../layouts/Layout.astro';
const cities = ['bali', 'fiji', 'maldives', 'others'];
---
<Layout title="全球热门目的地 - Sylvan Travel">
    <div class="city-hero">
        <h1>其他热门目的地</h1>
        <p>探索全球最令人向往的度假胜地。</p>
    </div>
    <section>
        <h2>目的地城市/地区</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
            {cities.map(city => (
                <a href={`/others/${city}`} style="text-decoration: none; color: inherit;">
                    <div class="route-card" style="text-align: center;">
                        <h3>{city.charAt(0).toUpperCase() + city.slice(1)}</h3>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Layout>
