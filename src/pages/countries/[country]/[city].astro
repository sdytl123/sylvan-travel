---
import Layout from '../../layouts/Layout.astro';
import { getCities, getRoutes } from '../../lib/googleSheets';

export async function getStaticPaths() {
  const cities = await getCities(); 
  return cities.map(city => ({
    params: { country: city.country_id, city: city.city_id },
    props: { cityInfo: city }
  }));
}

const { country, city } = Astro.params;
const { cityInfo } = Astro.props;
const routes = await getRoutes(city);
---
<Layout title={`${cityInfo.city_name} 旅游攻略 - Sylvan Travel`}>
    <div class="city-hero">
        <h1>探索 {cityInfo.city_name}</h1>
        <p>{cityInfo.description}</p>
    </div>
    <section>
        <h2>推荐路线</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
            {routes.map(route => (
                <a href={`/${country}/${city}/${route.route_id}`} style="text-decoration: none; color: inherit;">
                    <div class="route-card">
                        <h3>{route.route_name}</h3>
                        <p>时长: {route.duration} | 报价: {route.price}</p>
                        <span style="color: #3498db; font-size: 0.9rem;">查看详情 $\rightarrow$</span>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Layout>
