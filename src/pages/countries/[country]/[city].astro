---
import Layout from '../../../layouts/Layout.astro';
import DestinationCard from '../../../components/DestinationCard.astro';
import { getCountries, getCities, getRoutes } from '../../../lib/googleSheets';
export async function getStaticPaths() {
 const cities = await getCities();
 const countries = await getCountries();
 return cities.map(city => ({params:{country:city.country_id,city:city.city_id},props:{cityInfo:city,countryInfo:countries.find(country => country.country_id === city.country_id)}}));
}
const {cityInfo, countryInfo} = Astro.props;
const routes = await getRoutes(cityInfo.city_id);
const base = `/countries/${encodeURIComponent(cityInfo.country_id)}`;
---
<Layout title={cityInfo.seo_title || `${cityInfo.city_name}旅游 - Sylvan Travel`}>
<section class="max-w-7xl mx-auto px-6 py-16">
<nav><a href="/countries/">全部目的地</a> / <a href={`${base}/`}>{countryInfo.country_name}</a> / {cityInfo.city_name}</nav>
<h1 class="text-4xl font-bold text-sylvan-blue mt-8 mb-6">{cityInfo.city_name}</h1>
{cityInfo.description && <p class="whitespace-pre-line leading-relaxed mb-8">{cityInfo.description}</p>}
{(cityInfo.image_url || cityInfo.url) && <img src={cityInfo.image_url || cityInfo.url} alt={cityInfo.city_name} class="w-full max-w-2xl h-auto my-8" />}
<h2 class="text-2xl font-bold text-sylvan-blue mt-12 mb-8">推荐路线</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
{routes.map(route => <DestinationCard name={route.route_name} description={route.description} image={route.image_url || route.url} href={`${base}/${encodeURIComponent(cityInfo.city_id)}/${encodeURIComponent(route.route_id)}/`} detail={[route.duration,route.price].filter(Boolean).join(' · ')} />)}
</div>
{!routes.length && <p class="p-8 rounded-2xl bg-base-200">该城市的旅行路线正在整理中。</p>}
</section>
</Layout>
