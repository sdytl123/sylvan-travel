---
import Layout from '../../layouts/Layout.astro';
import CityContent from '../../components/CityContent.astro';
export async function getStaticPaths() {
  return ['melbourne', 'sydney', 'adelaide', 'goldcoast', 'others'].map(city => ({ params: { city } }));
}
const { city } = Astro.params;
---
<Layout title={`${city} 旅游攻略 - Sylvan Travel`}>
    <CityContent city={city} region="australia" />
</Layout>
