---
import Layout from '../layouts/Layout.astro';
const regions = [
  { id: 'australia', name: '澳大利亚', path: '/australia/' },
  { id: 'china', name: '中国', path: '/china/' },
  { id: 'others', name: '其他热门目的地', path: '/others/' },
];
---
<Layout title="Sylvan Travel - 全球定制旅游指南">
    <div class="city-hero">
        <h1>欢迎来到 Sylvan Travel</h1>
        <p>为您定制专属的全球旅行记忆</p>
    </div>

    <section class="region-grid">
        <h2>选择您的目的地</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
            {regions.map(region => (
                <a href={region.path} style="text-decoration: none; color: inherit;">
                    <div class="route-card" style="text-align: center; padding: 2rem;">
                        <h3>{region.name}</h3>
                        <p>探索精彩路线 $\rightarrow$</p>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Layout>
