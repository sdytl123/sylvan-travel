---
import Layout from '../layouts/Layout.astro';
import { getSheetData } from '../lib/googleSheets';

// 读取名为 'index' 的工作表
let sheetData = await getSheetData('index');

const fallbackServices = [
  { index_name1: '目的地', description1: '全球精选城市指南', image_url: 'https://images.unsplash.com/photo-1488646953014-bcdebc4e5?auto=format&fit=crop&w=800&q=80' },
  { index_name1: '活动', description1: '本地深度体验', image_url: 'https://images.unsplash.com/photo-1533174072545-7a40?auto=format&fit=crop&w=800&q=80' },
  { index_name1: '交通出行', description1: '私人定制交通', image_url: 'https://images.unsplash.com/photo-1449965409?auto=format&fit=crop&w=800&q=80' },
  { index_name1: '地陪翻译', description1: '专业多语种管家', image_url: 'https://images.unsplash.com/photo-1521737711881-3ed7a5bc4e5?auto=format&fit=crop&w=800&q=80' },
];

const finalData = (sheetData && sheetData.length > 0) ? sheetData : fallbackServices;

const services = finalData.map((item, index) => {
  const pathMap = {
    '目的地': '/countries/',
    '活动': '/activities',
    '交通出行': '/transport',
    '地陪翻译': '/guide'
  };
  const imageUrl = item.image_url || item.图片 || item.Image || item.img || '';

  return {
    id: item.id || index,
    index_name1: item.index_name1 || item.标题 || '未知服务', 
    description1: item.description1 || item.描述 || '暂无描述', 
    path: pathMap[item.index_name1] || pathMap[item.标题] || '#', 
    img: imageUrl || 'https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=800&q=80' 
  };
});
---
<Layout title="Sylvan Travel - 全球定制旅游指南">
    <!-- Hero Section -->
    <section class="relative h-[60vh] flex items-center justify-center text-center text-white overflow-hidden">
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1469854523086-cc02dropbox-d3c5?auto=format&fit=crop&w=1920&q=80" 
                 class="w-full h-full object-cover" 
                 alt="Travel Background" />
            <div class="absolute inset-0 bg-black/50"></div>
        </div>
        <div class="relative z-10 px-4 max-w-4xl">
            <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight">
                探索世界的 <span class="text-sylvan-gold">另一种可能</span>
            </h1>
            <p class="text-lg md:text-2xl mb-10 opacity-90 font-light">
                Sylvan Travel 为您定制专属的全球旅行记忆，让每一程都成为绝美故事。
            </p>
            <a href="#services" class="btn btn-primary bg-sylvan-gold hover:bg-yellow-600 border-none text-white px-8 py-4 rounded-full text-lg transition-all hover:scale-105">
                开始探索
            </a>
        </div>
    </section>

    <!-- Zig-Zag Services Section -->
    <section id="services" class="py-24 px-4 md:px-12 max-w-6xl mx-auto">
        <div class="text-center mb-20">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-sylvan-blue">我们的核心服务</h2>
            <div class="w-20 h-1 bg-sylvan-gold mx-auto rounded-full"></div>
            <p class="mt-4 text-base-content/60">从灵感激发到落地执行，为您提供全链路定制方案</p>
        </div>

        <div class="space-y-32">
            {services.map((service, index) => (
                <a href={service.path} class="group flex flex-col md:flex-row items-center gap-12 md:gap-20 transition-all duration-500">
                    {index % 2 === 0 ? (
                        <>
                            <!-- Image Container: FIXED ASPECT RATIO -->
                            <div class="w-full md:w-1/2 aspect-[4/3] overflow-hidden rounded-3xl shadow-xl relative">
                                <img src={service.img} 
                                     class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                                     alt={service.index_name1} />
                            </div>
                            <div class="w-full md:w-1/2 text-center md:text-left">
                                <h3 class="text-3xl md:text-4xl font-bold mb-6 text-sylvan-blue group-hover:text-sylvan-gold transition-colors">
                                    {service.index_name1}
                                </h3>
                                <p class="text-lg text-base-content/70 leading-relaxed">
                                    {service.description1}
                                </p>
                            </div>
                        </>
                    ) : (
                        <>
                            <div class="w-full md:w-1/2 text-center md:text-right order-2 md:order-1">
                                <h3 class="text-3xl md:text-4xl font-bold mb-6 text-sylvan-blue group-hover:text-sylvan-gold transition-colors">
                                    {service.index_name1}
                                </h3>
                                <p class="text-lg text-base-content/70 leading-relaxed">
                                    {service.description1}
                                </p>
                            </div>
                            <!-- Image Container: FIXED ASPECT RATIO -->
                            <div class="w-full md:w-1/2 aspect-[4/3] overflow-hidden rounded-3xl shadow-xl relative order-1 md:order-2">
                                <img src={service.img} 
                                     class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                                     alt={service.index_name1} />
                            </div>
                        </>
                    )}
                </a>
            ))}
        </div>
    </section>

    <!-- Trust Section -->
    <section class="py-20 bg-base-200 px-4">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
            <div class="flex flex-col items-center p-6">
                <div class="text-4xl mb-4">✨</div>
                <h4 class="text-xl font-bold mb-2 text-sylvan-blue">深度定制</h4>
                <p class="text-sm opacity-70">拒绝大众路线，根据您的喜好量身打造每一处细节。</p>
            </div>
            <div class="flex flex-col items-center p-6">
                <div class="text-4xl mb-4">🛡️</div>
                <h4 class="text-xl font-bold mb-2 text-sylvan-blue">全程管家</h4>
                <p class="text-sm opacity-70">从机票酒店到当地向导，提供 24/7 的管家式服务。</p>
            </div>
            <div class="flex flex-col items-center p-6">
                <div class="text-4xl mb-4">🌍</div>
                <h4 class="text-xl font-bold mb-2 text-sylvan-blue">全球资源</h4>
                <p class="text-sm opacity-70">深耕全球顶尖目的地，为您开启不为人知的私藏景点。</p>
            </div>
        </div>
    </section>
</Layout>
