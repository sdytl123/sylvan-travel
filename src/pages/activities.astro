---
import Layout from '../layouts/Layout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import { getActivities } from '../lib/googleSheets';
const activities = await getActivities();
---
<Layout title="活动 - Sylvan Travel">
  <section class="max-w-7xl mx-auto px-6 py-16">
    <nav aria-label="面包屑"><a href="/" class="text-sylvan-blue">首页</a> / 活动</nav>
    <h1 class="text-4xl font-bold text-sylvan-blue mt-8 mb-10">活动</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {activities.map(activity => (
        <DestinationCard
          name={activity.activity_name}
          description={activity.description}
          href={`/activities/${encodeURIComponent(activity.activity_id)}/`}
        />
      ))}
    </div>
  </section>
</Layout>
