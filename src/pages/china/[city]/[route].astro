---
import Layout from '../../../layouts/Layout.astro';
export async function getStaticPaths() {
  return [
    { params: { city: 'beijing', route: 'classic-tour' } },
    { params: { city: 'shanghai', route: 'classic-tour' } },
  ];
}
const { city, route } = Astro.params;
---
<Layout title={`${city} - ${route} 详细攻略`}>
    <div class="city-hero">
        <h1>{city} | {route}</h1>
        <p>欢迎来到中国 ${city} 的详细路线页面。</p>
    </div>
</Layout>
