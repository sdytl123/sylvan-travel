---
import Layout from '../../layouts/Layout.astro';
const cities = ['beijing', 'shanghai', 'xian', 'sanya', 'others'];
---
<Layout title="中国旅游攻略 - Sylvan Travel">
    <div class="city-hero">
        <h1>中国</h1>
        <p>从古都西安到现代上海，体验深厚的文化底蕴。</p>
    </div>
    <section>
        <h2>目的地城市</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
            {cities.map(city => (
                <a href={`/china/${city}`} style="text-decoration: none; color: inherit;">
                    <div class="route-card" style="text-align: center;">
                        <h3>{city.charAt(0).toUpperCase() + city.slice(1)}</h3>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Layout>
